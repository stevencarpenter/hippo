          },
          "queryType": "traceql",
          "query": "{resource.service.name = \"hippo-brain\" && name =~ \"enrichment.*\"}",
          "tableType": "traces",
          "limit": 20
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "footer": {
