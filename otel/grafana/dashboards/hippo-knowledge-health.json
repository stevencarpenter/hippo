      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (reason) (increase(hippo_kb_recall_failures_total[15m]))",
          "legendFormat": "{{reason}}",
          "range": true,
          "refId": "A"
