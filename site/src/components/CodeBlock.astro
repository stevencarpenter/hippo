<div class="code-block">
  <slot />
  <button class="code-copy" type="button" aria-label="Copy code to clipboard" data-copy>Copy</button>
  <p class="code-feedback" role="status" aria-live="polite"></p>
</div>

<script>
  document.addEventListener("click", async (event) => {
    if (!(event.target instanceof Element)) return;
    const button = event.target.closest("button[data-copy]");
    if (!(button instanceof HTMLButtonElement)) return;
    const wrapper = button.closest(".code-block");
    const pre = wrapper?.querySelector("pre");
    const feedback = wrapper?.querySelector(".code-feedback");
    if (!pre || !feedback) return;
    button.disabled = true;
    button.textContent = "Copy";
    feedback.textContent = "";
    try {
      await navigator.clipboard.writeText(pre.textContent || "");
      button.textContent = "Copied";
      feedback.textContent = "Copied to clipboard.";
    } catch {
      feedback.textContent = "Copy failed. Select the code and copy it manually.";
    } finally {
      button.disabled = false;
    }
  });
</script>

<style>
  .code-feedback { font-size: 0.875rem; color: var(--sepia); }
  .code-feedback:empty { display: none; }
</style>
