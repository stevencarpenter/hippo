---
// Pagefind search UI mount. Init logic + a11y patches per A9.
---
<div
  id="search"
  class="search-mount"
  role="region"
  aria-label="Search results"
></div>
<p id="search-fallback" role="status">Search requires JavaScript. You can also <a href="/docs">browse the documentation</a>.</p>
<link rel="stylesheet" href="/pagefind/pagefind-ui.css" />
<script src="/pagefind/pagefind-ui.js" is:inline></script>
<script is:inline>
  // Native navigation initializes a fresh Pagefind instance on each visit.
  (() => {
    if (typeof PagefindUI === "undefined") {
      document.getElementById("search-fallback").firstChild.textContent = "Search could not load. Reload the page or ";
      return;
    }
    var mount = document.getElementById("search");
    new PagefindUI({
      element: "#search",
      showImages: false,
      showSubResults: true,
      translations: {
        placeholder: "Search documentation…",
        clear_search: "Clear search",
        load_more: "Load more results",
        search_label: "Search the docs and field notes",
        filters_label: "Filter results",
        zero_results: "No entries match. Try a broader term, or browse the docs index.",
        many_results: "[COUNT] results for [SEARCH_TERM]",
        one_result: "[COUNT] result for [SEARCH_TERM]",
        alt_search: "Did you mean [DIFFERENT_TERM]?",
        search_suggestion: "No results for [SEARCH_TERM]. Try one of the suggested terms below.",
        searching: "Searching for [SEARCH_TERM]…",
      },
    });
    document.getElementById("search-fallback").hidden = true;
    // Pagefind creates its input synchronously. Its results message already
    // supplies aria-live; only a visible input label is missing.
    const input = mount.querySelector("input");
    input.id = "hippo-search-input";
    const label = document.createElement("label");
    label.htmlFor = input.id;
    label.textContent = "Search the docs and field notes";
    mount.before(label);
    // The bundled UI has no error callback. Keep recovery available if an index
    // request stalls; do not claim a network error merely because it is slow.
    let pending;
    input.addEventListener("input", () => {
      clearTimeout(pending);
      document.getElementById("search-fallback").hidden = true;
      pending = setTimeout(() => {
        if (!mount.querySelector(".pagefind-ui__message")?.textContent.startsWith("Searching for ")) return;
        const fallback = document.getElementById("search-fallback");
        fallback.firstChild.textContent = "Search is taking longer than expected. Reload the page or ";
        fallback.hidden = false;
      }, 10000);
    });
  })();
</script>

<style>
  .search-mount {
    --pagefind-ui-primary: var(--oxblood);
    --pagefind-ui-text: var(--ink);
    --pagefind-ui-background: var(--paper);
    --pagefind-ui-border: var(--rule);
    --pagefind-ui-tag: var(--sepia);
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 0;
    --pagefind-ui-image-border-radius: 0;
    --pagefind-ui-image-box-ratio: 3 / 2;
    --pagefind-ui-font: var(--font-body-1);
  }
</style>
