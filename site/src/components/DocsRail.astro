---
import type { SidebarSection } from "../lib/docs.ts";

export interface Props {
  sections: SidebarSection[];
  currentSlug: string;
}
const { sections, currentSlug } = Astro.props;
---
<aside class="docs-rail-left" aria-label="Section navigation">
  <details open class="rail-details">
    <summary>Sections</summary>
    {sections.map((section) => (
      <details class="section" open={section.id === "getting-started" || section.entries.some((entry) => entry.slug === currentSlug) || section.url === `/docs/${currentSlug}`}>
        <summary><h2>{section.label}</h2></summary>
        {section.caption && <span class="caption" lang="la"><em>{section.caption}</em></span>}
        <ul>
          {section.url && <li><a href={section.url} aria-current={section.url === `/docs/${currentSlug}` ? "page" : undefined}>Overview</a></li>}
          {section.entries.map((entry) => {
            const active = entry.slug === currentSlug;
            return (
              <li>
                <a href={entry.url} aria-current={active ? "page" : undefined}>{entry.title}</a>
              </li>
            );
          })}
        </ul>
      </details>
    ))}
  </details>
</aside>

<script is:inline>
  (() => {
    const menu = document.querySelector(".rail-details");
    const desktop = window.matchMedia("(min-width: 769px)");
    const sync = () => { menu.open = desktop.matches; };
    sync();
    desktop.addEventListener("change", sync);
  })();
</script>

<style>
  /* On non-mobile screens, ignore the <details> chrome — display children plain. */
  @media (min-width: 769px) {
    .docs-rail-left .rail-details { display: contents; }
    .docs-rail-left .rail-details > summary { display: none; }
  }
  .section > summary { cursor: pointer; min-height: 44px; align-content: center; color: var(--sepia); }
  .section > summary h2 { display: inline; }
</style>
