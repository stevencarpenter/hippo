---
import type { MarkdownHeading } from "astro";

export interface Props {
  headings: MarkdownHeading[];
}
const { headings } = Astro.props;
const filtered = headings.filter((h) => h.depth === 2 || h.depth === 3);
---
{filtered.length >= 3 && (
  <aside class="docs-rail-right" aria-label="On this page">
    <h2>On this page</h2>
    <ul>
      {filtered.map((h) => (
        <li class={`depth-${h.depth}`}>
          <a href={`#${h.slug}`} data-heading-link={h.slug}>{h.text}</a>
        </li>
      ))}
    </ul>
  </aside>
)}

<script is:inline>
  // Highlight active heading on scroll. Updates aria-current="location" (A6).
  (() => {
    const links = Array.from(document.querySelectorAll('[data-heading-link]'));
    if (!links.length) return;
    const targets = links.map((link) => document.getElementById(link.dataset.headingLink));
    const observer = new IntersectionObserver(() => {
      const active = targets.findLast((heading) => heading && heading.getBoundingClientRect().top <= innerHeight * 0.3) || targets[0];
      links.forEach((link) => {
        if (link.dataset.headingLink === active?.id) link.setAttribute("aria-current", "location");
        else link.removeAttribute("aria-current");
      });
    }, { rootMargin: '0px 0px -70% 0px', threshold: 0 });
    targets.forEach((t) => t && observer.observe(t));
  })();
</script>
