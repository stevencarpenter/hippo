<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
      Keeper for the oMLX macOS app. Every 60 s it checks the inference
      server named by [inference].base_url in Hippo's config.toml:
      - The server answers: do nothing, even when the app did not start it.
      - oMLX.app is not running: do nothing. The user quit it, and the app's
        own Launch-at-Login entry (com.omlx.app) starts it at login.
      - The app runs without a server: ask it to start one.
      It never opens the app, so Cmd+Q stays quit, including across the
      dark wakes launchd runs this job in while the lid is closed.
      No KeepAlive on purpose.
    -->
    <key>Label</key>
    <string>com.hippo.omlx</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/sh</string>
        <string>-c</string>
        <string>url=$(sed -n 's/^base_url *= *"\([^"]*\)".*/\1/p' "${XDG_CONFIG_HOME:-$HOME/.config}/hippo/config.toml" 2>/dev/null | head -n 1); curl -fs -o /dev/null --max-time 3 "${url:-http://127.0.0.1:42069/v1}/models" || ! pgrep -xq oMLX || exec /Applications/oMLX.app/Contents/MacOS/omlx-cli start --no-wait</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>__HOME__</string>
        <key>PATH</key>
        <string>__PATH__</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>StartInterval</key>
    <integer>60</integer>
    <key>StandardOutPath</key>
    <string>__DATA_DIR__/omlx.stdout.log</string>
    <key>StandardErrorPath</key>
    <string>__DATA_DIR__/omlx.stderr.log</string>
    <key>WorkingDirectory</key>
    <string>__HOME__</string>
</dict>
</plist>
